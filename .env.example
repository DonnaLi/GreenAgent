# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql+psycopg://green_agent:green_agent@localhost:5432/green_agent
LLM_API_KEY=
EMISSIONS_API_KEY=

# Carrier agents (see agents/README.md). "local" calls them in-process.
CARRIER_TRANSPORT=local
# Seeds every agent key. The default is public; set your own outside local dev.
AGENT_SEED_PREFIX=green-agent-dev
